Options -Indexes
DirectoryIndex index.php

RewriteEngine On

# Keep public URLs independent from the PHP implementation. Redirect legacy
# browser requests, then resolve the clean routes internally.
RewriteCond %{THE_REQUEST} \s/+index\.php(?:[?\s]) [NC]
RewriteRule ^index\.php$ / [R=301,L]

RewriteCond %{THE_REQUEST} \s/+(about|rosary|prayers|contact)\.php(?:[?\s]) [NC]
RewriteRule ^(about|rosary|prayers|contact)\.php$ /$1 [R=301,L,NE]

RewriteCond %{THE_REQUEST} \s/+(about|rosary|prayers|contact|privacy|safety|sources)/(?:[?\s]) [NC]
RewriteRule ^(about|rosary|prayers|contact|privacy|safety|sources)/$ /$1 [R=301,L,NE]

# A permanent method-preserving redirect keeps older cached chat clients valid.
RewriteCond %{THE_REQUEST} \s/+api/chat\.php(?:[?\s]) [NC]
RewriteRule ^api/chat\.php$ /api/chat [R=308,L,NE]

RewriteCond %{THE_REQUEST} \s/+api/feedback\.php(?:[?\s]) [NC]
RewriteRule ^api/feedback\.php$ /api/feedback [R=308,L,NE]

RewriteCond %{THE_REQUEST} \s/+trust\.php(?:[?\s]) [NC]
RewriteRule ^trust\.php$ - [R=404,L]

RewriteRule ^(about|rosary|prayers|contact)/?$ $1.php [END,QSA]
RewriteRule ^(privacy|safety|sources)/?$ trust.php?page=$1 [END,QSA]
RewriteRule ^api/chat/?$ api/chat.php [END,QSA]
RewriteRule ^api/feedback/?$ api/feedback.php [END,QSA]

# Keep application code, configuration, and reviewed Scripture data private
# while allowing Hostinger to deploy this repository directly to public_html.
RedirectMatch 404 ^/(?:src|data|storage|\.git)(?:/|$)
RedirectMatch 404 ^/(?:\.env|\.env\.example|\.gitignore|README\.md|LICENSE)$

<FilesMatch "^\.">
  Require all denied
</FilesMatch>

<Files "manifest.webmanifest">
  ForceType application/manifest+json
</Files>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://cpbjr.github.io; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
</IfModule>

